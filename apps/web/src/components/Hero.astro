---
// Before / after: the photo on the left, the same photo screened live by the engine on the right.
// Chips swap the look; the divider can be dragged (or moved with the arrow keys).
import { HERO_LOOKS, studioHref } from '../landing/looks';
const first = HERO_LOOKS[0]!;
---
<section class="frame hero" aria-label="Before and after">
  <div class="compare" data-compare style="--split: 50%">
    <img class="before" src="/samples/demo.jpg" alt="The original photograph" width="1605" height="909" draggable="false" data-src />
    <canvas class="after" data-after aria-label="The same photograph, screened by Halftone"></canvas>
    <span class="tag tag--l">Before</span>
    <span class="tag tag--r">After</span>
    <div class="line" aria-hidden="true"></div>
    <button class="handle" type="button" role="slider" aria-label="Compare before and after" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" data-handle>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 4 2 8l4 4M10 4l4 4-4 4"/></svg>
    </button>
    <div class="chips" role="radiogroup" aria-label="Screen">
      {HERO_LOOKS.map(l => (
        <button type="button" class="chip" role="radio" aria-checked={String(l === first)} data-look={JSON.stringify(l.look)} data-href={studioHref(l.look)}>{l.name}</button>
      ))}
    </div>
  </div>
</section>

<section class="frame intro">
  <div>
    <p class="label"><b>■</b> A screen engine for the web</p>
    <h1 class="display">Real halftone,<br />in real time.</h1>
    <p class="lede">A free studio tool and an open-source engine. Seven dot shapes, six dithers and a CRT, rendered on your GPU and tone-accurate to under one L*. In your browser, no upload, no signup.</p>
  </div>
  <div class="intro-cta">
    <a href={studioHref(first.look)} class="btn btn--solid btn--lg" data-open>Open in the studio</a>
    <p class="intro-note" data-readout></p>
  </div>
</section>

<style>
  .hero { border-bottom: 1px solid var(--line); }
  .compare { position: relative; aspect-ratio: 1200 / 560; overflow: hidden; background: #000; -webkit-user-select: none; user-select: none; touch-action: pan-y; }
  .before, .after { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; }
  .after { clip-path: inset(0 0 0 var(--split)); }
  .line { position: absolute; top: 0; bottom: 0; left: var(--split); width: 1px; background: rgba(255, 255, 255, .8); pointer-events: none; }
  .handle {
    position: absolute; top: 50%; left: var(--split); transform: translate(-50%, -50%);
    width: 44px; height: 44px; display: grid; place-items: center; cursor: ew-resize;
    border: 1px solid rgba(255, 255, 255, .8); background: rgba(5, 5, 6, .6); color: #fff; backdrop-filter: blur(6px);
  }
  .tag {
    position: absolute; top: 16px; padding: 6px 9px; background: rgba(5, 5, 6, .8); border: 1px solid var(--line-2);
    font: 400 11px/1 var(--pixel); letter-spacing: .14em; text-transform: uppercase;
  }
  .tag--l { left: 16px; } .tag--r { right: 16px; }
  .chips { position: absolute; left: 16px; right: 16px; bottom: 16px; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    height: 32px; padding: 0 12px; cursor: pointer; border: 1px solid var(--line-2);
    background: rgba(5, 5, 6, .8); color: var(--fg-2); backdrop-filter: blur(6px);
    font: 400 12px/1 var(--pixel); letter-spacing: .06em; text-transform: uppercase;
  }
  .chip:hover { color: var(--fg); border-color: rgba(255, 255, 255, .5); }
  .chip[aria-checked='true'] { background: var(--fg); border-color: var(--fg); color: var(--bg); }

  .intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding: 56px var(--pad) 64px; border-bottom: 1px solid var(--line); }
  .intro .display { margin-top: 20px; }
  .intro-cta { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .intro-note { margin: 0; font: 400 11px/1 var(--pixel); letter-spacing: .08em; text-transform: uppercase; color: var(--fg-3); }

  @media (max-width: 960px) {
    .compare { aspect-ratio: 4 / 5; }
    .chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .chip { flex: none; }
    .intro { flex-direction: column; align-items: flex-start; }
    .intro-cta { align-items: flex-start; }
  }
</style>

<script>
  import { Halftone, DiffusionWorker } from '@interfaz/halftone';
  import { toEngine } from '../app/state';
  import { fullLook } from '../landing/looks';
  import { loadBitmap } from '../landing/render';

  const root = document.querySelector<HTMLElement>('[data-compare]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-after]')!;
  const handle = root.querySelector<HTMLButtonElement>('[data-handle]')!;
  const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
  const open = document.querySelector<HTMLAnchorElement>('[data-open]')!;
  const readout = document.querySelector<HTMLElement>('[data-readout]')!;

  // ── divider ──────────────────────────────────────────────
  let split = 50;
  const setSplit = (v: number) => {
    split = Math.min(100, Math.max(0, v));
    root.style.setProperty('--split', `${split}%`);
    handle.setAttribute('aria-valuenow', String(Math.round(split)));
  };
  let dragging = false;
  const fromEvent = (e: PointerEvent) => { const r = root.getBoundingClientRect(); setSplit(((e.clientX - r.left) / r.width) * 100); };
  // Drag from the handle or anywhere on the picture. preventDefault stops the browser from starting
  // a text selection or picking up the image as a draggable file.
  const startDrag = (e: PointerEvent, el: HTMLElement) => { e.preventDefault(); dragging = true; el.setPointerCapture(e.pointerId); };
  handle.addEventListener('pointerdown', e => startDrag(e, handle));
  root.addEventListener('pointerdown', e => {
    if (e.target === root || e.target === canvas || (e.target as HTMLElement).dataset.src !== undefined) { startDrag(e, root); fromEvent(e); }
  });
  root.addEventListener('pointermove', e => { if (dragging) fromEvent(e); });
  for (const t of ['pointerup', 'pointercancel'] as const) root.addEventListener(t, () => { dragging = false; });
  root.addEventListener('dragstart', e => e.preventDefault());
  handle.addEventListener('keydown', e => {
    const step = e.shiftKey ? 10 : 2;
    if (e.key === 'ArrowLeft') { e.preventDefault(); setSplit(split - step); }
    if (e.key === 'ArrowRight') { e.preventDefault(); setSplit(split + step); }
  });

  // ── live render ──────────────────────────────────────────
  if (Halftone.isSupported()) {
    const engine = new Halftone(canvas, { fit: 'cover' });
    const worker = new DiffusionWorker();
    let look = JSON.parse(chips[0]!.dataset.look!);
    let frame = 0;
    const img = await loadBitmap('/samples/demo.jpg');
    engine.setSource(img);

    const draw = async () => {
      frame = 0;
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(2, devicePixelRatio);
      engine.resize(r.width * dpr, r.height * dpr);
      engine.set({ ...toEngine(fullLook(look)), fit: 'cover', pixelRatio: dpr });
      if (engine.diffusionJob()) await engine.updateDiffusion(job => worker.run(job));
      engine.render();
    };
    const request = () => { if (!frame) frame = requestAnimationFrame(() => { void draw(); }); };
    new ResizeObserver(request).observe(canvas);

    const select = (chip: HTMLButtonElement) => {
      chips.forEach(c => c.setAttribute('aria-checked', String(c === chip)));
      look = JSON.parse(chip.dataset.look!);
      open.href = chip.dataset.href!;
      readout.textContent = `Opens with: ${chip.textContent}`;
      request();
    };
    chips.forEach(c => c.addEventListener('click', () => select(c)));
    select(chips[0]!);
  } else {
    readout.textContent = 'Live preview needs WebGL2';
    canvas.hidden = true;
  }
</script>
